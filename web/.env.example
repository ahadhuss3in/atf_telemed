# Copy to .env.local for local development.
#
# Local FastAPI signaling server:
NEXT_PUBLIC_SIGNALING_URL=ws://127.0.0.1:8000/ws
#
# Deployed Railway signaling server (set this in the Vercel project settings
# instead, so it is baked in at build time):
# NEXT_PUBLIC_SIGNALING_URL=wss://your-service.up.railway.app/ws